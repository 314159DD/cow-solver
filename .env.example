# ─── Required ────────────────────────────────────────────────────────────────
# Ethereum JSON-RPC endpoint (Alchemy or Infura free tier works fine)
# Alchemy:  https://alchemy.com  → create app → copy HTTP URL
# Infura:   https://infura.io    → create project → copy endpoint
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# ─── Optional ────────────────────────────────────────────────────────────────
# HTTP port for the solver engine (default: 8000)
SOLVER_PORT=8000

# Target chain: 1=Ethereum mainnet, 42161=Arbitrum One, 100=Gnosis Chain
CHAIN_ID=1

# Tracing log level: trace | debug | info | warn | error
LOG_LEVEL=info

# Maximum time (ms) allowed per solve request.
# CoW auctions last ~30 seconds; we use 25s to leave a 5s buffer.
MAX_SOLVE_TIME_MS=25000

# CoW Protocol Driver URL (optional - only needed if running with driver)
# Leave empty when testing with scripts/local_test.sh only.
DRIVER_URL=

# ─── External Aggregator API Keys (optional) ─────────────────────────────────
# These enable Strategy 7: external aggregator quotes from 0x and 1inch.
# Get a free key at https://dashboard.0x.org/
ZEROX_API_KEY=
# Get a free key at https://portal.1inch.dev/
ONEINCH_API_KEY=

# ─── Telegram Alerting (optional but strongly recommended for production) ─────
# Create a bot via @BotFather, then add it to a channel and get the chat ID.
# If unset, all alerts are silently skipped (safe for local dev).
# Alert triggers: solver silent 5min, win rate <1%, RPC errors >10%,
#                 EBBO violations, response timeouts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
